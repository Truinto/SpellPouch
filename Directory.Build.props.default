<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<Zip7>C:/Program Files/7-Zip/7z.exe</Zip7>
		<ProgramFolder>C:/Games/</ProgramFolder>
		<GameManaged Condition="Exists('$(ProgramFolder)')">$(ProgramFolder)Pathfinder Wrath of the Righteous/Wrath_Data/Managed</GameManaged>
		<GameManaged Condition="!Exists('$(ProgramFolder)')">../../1st_sources/KM2 sources/Wrath_Data/Managed</GameManaged>
		<ModFolder Condition="Exists('$(ProgramFolder)')">$(ProgramFolder)Pathfinder Wrath of the Righteous/Mods</ModFolder>
		<ModFolder Condition="!Exists('$(ProgramFolder)')">../../1st_sources/KM2 sources/Wrath_Data/Managed</ModFolder>
	</PropertyGroup>
</Project>
